# ---- required ---------------------------------------------------------------

# The public hostname clients reach this server at — the name on the
# certificate, not the machine's IP and not localhost. It anchors the
# whole DNS trust chain: identities are signed for this domain and peers verify
# them against the _revoked TXT record published under it, so a value that does
# not match reality produces identities every remote verifier rejects. The
# server refuses to boot without it.
DOMAIN=example.com

# ---- ports & topology (docker compose only) ---------------------------------

# The port the API listens on inside the container. Behind a reverse proxy this
# is the port you point the proxy at; nothing is published to the host, so it
# does not have to be free on the machine.
API_PORT=3000

# The container's name, which is also the hostname your reverse proxy uses.
CONTAINER_NAME=revoked-api

# The Docker network shared with your reverse proxy. Create it once with
#   docker network create proxy-network
# (or name the one the proxy already uses), and attach the proxy's container to
# it. Point the proxy at CONTAINER_NAME:API_PORT over plain http — nothing is
# published to the host, so the API cannot be reached by IP and no one can skip
# the TLS the proxy terminates.
PROXY_NETWORK=proxy-network

# Standalone only (docker compose --profile proxy up -d): what the bundled
# nginx listens on. This is the one thing that publishes a host port.
HTTP_PORT=80
HTTPS_PORT=443

# ---- storage ----------------------------------------------------------------

# Where the server's root key lives. Defaults to pb_data/server_root.pem,
# resolved against the working directory — leave it alone unless you keep the
# key somewhere else. docker compose sets the container's own path.
# Everything under pb_data is the state that cannot be regenerated: lose it and
# every identity this server ever issued stops verifying.
# SERVER_KEY_PATH=pb_data/server_root.pem

# ---- registration -----------------------------------------------------------

# Whether anyone may create their own account. Off by default: a server nobody
# configured should be one only its operator can add people to, not one the
# internet can. With it off the sign-up screen reports the refusal and accounts
# are made by a superuser instead:
#
#   docker compose exec api /pb/revoked user upsert someone@example.com 'password'
#
# or from the dashboard at /_/ , or via the seed pair below.
ALLOW_SIGNUPS=false

# ---- seed accounts ----------------------------------------------------------
# Created on first boot when both halves of a pair are set. Convenient for a
# test box; on anything reachable, create the superuser interactively instead
# and leave these blank.

ADMIN_EMAIL=
ADMIN_PASSWORD=

USER_EMAIL=
USER_PASSWORD=

# ---- outbound requests ------------------------------------------------------

# Allow user-supplied callback URLs to resolve to loopback, link-local and
# private ranges. Off by default because on a public host that is a
# server-side request forgery primitive; turn it on only for a LAN-only install.
ALLOW_PRIVATE_CALLBACKS=false

# ---- rate limits ------------------------------------------------------------
# Public-surface budgets. 0 disables a limiter entirely. These are read once at
# startup, so a change needs a restart.

# Password/identifier attempts on a share gate, per IP+slug, per 5 minutes.
RATELIMIT_GATE_ATTEMPTS=10

# Metadata probes and short-link reads, per IP, per minute. This is the
# enumeration budget across every slug.
RATELIMIT_PROBE_REQUESTS=120

# Handshake nonce issuance, per IP, per minute.
RATELIMIT_CHALLENGE_REQUESTS=60

# ---- files ------------------------------------------------------------------
# Per-file and per-workspace upload budgets, in megabytes. -1 (or unset) means
# unlimited; 0 disables file uploads entirely. Enforced at request time, so a
# change needs a restart but no migration.
FILE_MAX_SIZE=-1
FILE_MAX_STORAGE=-1
