# ---- required ---------------------------------------------------------------

# The public hostname clients reach this server at — the name on the
# certificate, not the machine's IP and not localhost. It anchors the
# whole DNS trust chain: identities are signed for this domain and peers verify
# them against the _revoked TXT record published under it, so a value that does
# not match reality produces identities every remote verifier rejects. The
# server refuses to boot without it.
DOMAIN=example.com

# ---- ports & topology (docker compose only) ---------------------------------

# The port the API listens on inside the container, and the one a reverse
# proxy forwards to.
API_PORT=3000

# Where the API is published on the host. The default answers on this machine
# only, at http://127.0.0.1:3000: the address a reverse proxy running on this
# host forwards to, and the one an SSH tunnel reaches the dashboard at. A bare
# port such as 3000 publishes it on every interface over plain http, skipping
# the proxy's TLS: never on a public host.
API_PUBLISH=127.0.0.1:3000

# The container's name, which is also the hostname a proxy in another
# container forwards to (docker-compose.network.yml).
CONTAINER_NAME=revoked-api

# Only with docker-compose.network.yml: the existing Docker network a proxy in
# its own container (Nginx Proxy Manager, Traefik) is on.
PROXY_NETWORK=proxy-network

# Only with the bundled Caddy (docker compose --profile caddy up -d): the ports
# it listens on, and the address it serves and gets a certificate for. Left
# empty, that address is DOMAIN; `localhost` serves a local test with Caddy's
# own certificate.
HTTP_PORT=80
HTTPS_PORT=443
SITE_ADDRESS=

# The header the reverse proxy puts the client's address in, which rate limits
# key on. Every common proxy, the bundled Caddy included, uses X-Forwarded-For.
# `none` trusts no header: only for a server reached without any proxy, where a
# client could write the header itself.
TRUSTED_PROXY_HEADER=X-Forwarded-For

# Who reaches the superuser dashboard (/_/) and its sign-in. `local` answers
# only requests that reach the container directly — from this machine, or over
# an SSH tunnel to API_PUBLISH — never anything that came through the proxy.
# `public` serves it to the internet as well.
DASHBOARD_ACCESS=local

# The server image to run: the full reference, not a tag alone. Pin a release,
# such as ghcr.io/argseby/revoked:v0.36.0; :latest only moves when the image is
# pulled again. docker-compose.yml always runs this image and never builds.
REVOKED_IMAGE=ghcr.io/argseby/revoked:latest

# Only for builds from source (docker-compose.build.yml): the version such a
# server reports. Left empty, the build reads it from the checkout's git tags; a
# copy without .git reports `dev` unless this is set.
REVOKED_VERSION=

# ---- storage ----------------------------------------------------------------

# Where the server's root key lives. Defaults to pb_data/server_root.pem,
# resolved against the working directory — leave it alone unless you keep the
# key somewhere else. docker compose sets the container's own path.
# Everything under pb_data is the state that cannot be regenerated: lose it and
# every identity this server ever issued stops verifying.
# SERVER_KEY_PATH=pb_data/server_root.pem

# ---- registration -----------------------------------------------------------

# Whether anyone may create their own account. Off by default: a server nobody
# configured should be one only its operator can add people to, not one the
# internet can. With it off the sign-in page reports the refusal and accounts
# are made by the operator instead:
#
#   docker compose exec api /pb/revoked user upsert someone@example.com
#
# which prints a one-time link where that person saves their passkey. There
# are no passwords. The USER_EMAIL seed below works too.
ALLOW_SIGNUPS=false

# Make a new account confirm its email address first: the sign-in page mails a
# 6-digit code, and only the right code lets the passkey be saved. Without it,
# anyone can register any address. Needs the mail server below; the server
# refuses to boot with this on and no SMTP_HOST / SMTP_SENDER_ADDRESS.
SIGNUP_VERIFY_EMAIL=false

# Require an authenticator app (a 6-digit code, TOTP) after the passkey for
# every account. Off, each person decides in Settings. On, an account without
# one is asked to set one up right after signing in, and nobody can turn theirs
# off. Someone who lost their authenticator is let back in by the operator:
#
#   docker compose exec api /pb/revoked user reset-2fa someone@example.com
#
# which removes it, ends that account's sessions and writes an audit entry.
REQUIRE_2FA=false

# Whether this server may email somebody a link when a person here shares with
# them or asks them for something, and that person has no account. This is the
# one thing a user can do that makes the server contact a stranger, so pick the
# reach: off sends nothing and hands the sender the link to pass on;
# same-domain reaches addresses in your own DOMAIN; trusted reaches addresses
# whose domain publishes a Revoked server you can verify (which proves the
# domain, not the mailbox); all reaches anyone. Needs the mail server below.
# A request sent this way is only emailed while ALLOW_SIGNUPS is on, because
# answering one needs an account. The email never carries what was shared.
GRANT_EMAIL_RECIPIENTS=off

# Where people download the app. On a computer, the app shows a QR code to
# move sign-up to the phone; it opens /app, which offers the store for that
# phone. Unset, the page only offers to open the app. https links only.
APP_STORE_URL=
PLAY_STORE_URL=

# ---- attestations -----------------------------------------------------------

# Whether this server issues attestations: statements about other people's
# identities, signed in the name of DOMAIN. Off by default, for the reason
# signups are — whoever trusts the domain trusts everything issued under it,
# so on a server several people share this is the operator's decision. With it
# on, a workspace member still needs the "Issue attestations" permission.
# Holding and verifying credentials work either way.
ALLOW_ATTESTATIONS=false

# ---- blocked domains --------------------------------------------------------

# A file of domains to warn this server's users off, in the format of the
# repository's blocked-domains.txt. The app refuses to switch to a server
# listed there or in the project's own list; this file adds to that list and
# cannot remove from it. Re-read on every request, so edits need no restart.
BLOCKED_DOMAINS_FILE=

# ---- mail -------------------------------------------------------------------
# The outbound mail server, used for signup confirmation codes. Overrides what
# the /_/ dashboard stored, at every start; leave SMTP_HOST empty to keep the
# dashboard's settings. SMTP_TLS=true is implicit TLS (usually port 465);
# false means STARTTLS when offered (usually 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SENDER_ADDRESS=
SMTP_SENDER_NAME=Revoked

# ---- seed accounts ----------------------------------------------------------
# Created on first boot. Convenient for a test box; on anything reachable,
# create the superuser interactively instead and leave these blank.

ADMIN_EMAIL=
ADMIN_PASSWORD=

# A regular account. It has no password: while it has no passkey, every start
# logs a one-time link to add one.
USER_EMAIL=

# ---- outbound requests ------------------------------------------------------

# Allow user-supplied callback URLs to resolve to loopback, link-local and
# private ranges. Off by default because on a public host that is a
# server-side request forgery primitive; turn it on only for a LAN-only install.
ALLOW_PRIVATE_CALLBACKS=false

# ---- rate limits ------------------------------------------------------------
# How many callers the server talks to at once. Past this a caller waits for a
# free slot and gives up if none comes; without a ceiling, enough callers at
# once exhaust the server's memory and the machine stops it. 0 removes it.
MAX_CONNECTIONS=2048

# Public-surface budgets. 0 disables a limiter entirely. These are read once at
# startup, so a change needs a restart.

# Password/identifier attempts on a share gate, per IP+slug, per 5 minutes.
RATELIMIT_GATE_ATTEMPTS=10

# Metadata probes, short-link and CardDAV reads, and link unlocks, per IP, per
# minute. This is the enumeration budget across every slug. /api/server,
# certificates and the OpenID Connect sign-in page each get a budget this size
# of their own.
RATELIMIT_PROBE_REQUESTS=120

# Handshake nonce issuance, per IP, per minute.
RATELIMIT_CHALLENGE_REQUESTS=60

# Passkey sign-in and registration steps, per IP, per minute.
RATELIMIT_PASSKEY_REQUESTS=60

# Signup confirmation codes mailed, per IP, per hour. Each address is also
# limited to one code a minute and five an hour.
RATELIMIT_SIGNUP_EMAILS=10

# Answers to requests, per account, per hour. Each one notifies the request's
# owner and may call their callback URL.
RATELIMIT_SUBMISSIONS=60

# Links emailed to one address, per hour, whoever sends them. The only cap
# here protecting someone who is not using your server, so it is counted in
# the database and holds even across several instances.
RATELIMIT_GRANT_EMAILS=5

# Links emailed by one workspace, per hour. Guards your own sending quota,
# which the per-account cap stops doing once a workspace invites members.
# In memory, so more than one instance multiplies it.
RATELIMIT_WORKSPACE_EMAILS=30

# ---- files ------------------------------------------------------------------
# Per-file and per-workspace upload budgets, in megabytes. -1 (or unset) means
# unlimited; 0 disables file uploads entirely. Enforced at request time, so a
# change needs a restart but no migration.
FILE_MAX_SIZE=-1
FILE_MAX_STORAGE=-1
