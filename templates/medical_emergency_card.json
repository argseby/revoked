{
  "name": "Medical emergency card",
  "description": "What a doctor needs to know when you cannot tell them — share it with family or take it on a trip.",
  "schema": {
    "records": [
      {
        "key": "blood_type",
        "label": "Blood type",
        "type": "text"
      },
      {
        "key": "allergies",
        "label": "Allergies",
        "type": "text"
      },
      {
        "key": "medications",
        "label": "Current medications",
        "type": "text"
      },
      {
        "key": "organ_donor",
        "label": "Organ donor",
        "type": "boolean"
      },
      {
        "key": "insurance_provider",
        "label": "Health insurance",
        "type": "text"
      },
      {
        "key": "insurance_number",
        "label": "Insurance number",
        "type": "text"
      }
    ],
    "sections": [
      {
        "key": "personal_information",
        "name": "Personal information",
        "records": [
          {
            "key": "full_name",
            "label": "Full name",
            "type": "text"
          }
        ]
      },
      {
        "key": "emergency_contact",
        "name": "Emergency contact",
        "records": [
          {
            "key": "contact_name",
            "label": "Contact name",
            "type": "text"
          },
          {
            "key": "contact_phone",
            "label": "Contact phone",
            "type": "text"
          },
          {
            "key": "contact_relation",
            "label": "Contact relation",
            "type": "text"
          }
        ]
      },
      {
        "key": "doctor",
        "name": "Doctor",
        "records": [
          {
            "key": "doctor_name",
            "label": "Doctor name",
            "type": "text"
          },
          {
            "key": "doctor_phone",
            "label": "Doctor phone",
            "type": "text"
          }
        ]
      }
    ],
    "view": {
      "version": 1,
      "id": "emergency",
      "name": "Emergency card",
      "accent": "red",
      "match": [
        "blood_type"
      ],
      "blocks": [
        {
          "type": "header",
          "icon": "health",
          "eyebrow": "Medical emergency card",
          "title": "{full_name}"
        },
        {
          "type": "badges",
          "items": [
            {
              "text": "Organ donor",
              "tone": "success",
              "when": {
                "key": "organ_donor",
                "is": "true"
              }
            },
            {
              "text": "Blood type {blood_type}",
              "tone": "danger",
              "when": {
                "key": "blood_type"
              }
            }
          ]
        },
        {
          "type": "facts",
          "items": [
            {
              "label": "Allergies",
              "value": "{allergies}"
            },
            {
              "label": "Medications",
              "value": "{medications}"
            },
            {
              "label": "Insurance",
              "value": "{insurance_provider}"
            },
            {
              "label": "Insurance number",
              "value": "{insurance_number}",
              "mono": true
            }
          ]
        },
        {
          "type": "divider",
          "when": {
            "key": "contact_name"
          }
        },
        {
          "type": "facts",
          "items": [
            {
              "label": "Emergency contact",
              "value": "{contact_name}"
            },
            {
              "label": "Relation",
              "value": "{contact_relation}"
            },
            {
              "label": "Doctor",
              "value": "{doctor_name}"
            }
          ]
        },
        {
          "type": "actions",
          "items": [
            {
              "label": "Call {contact_name}",
              "key": "contact_phone",
              "kind": "tel"
            },
            {
              "label": "Call the doctor",
              "key": "doctor_phone",
              "kind": "tel"
            }
          ]
        }
      ]
    }
  }
}
