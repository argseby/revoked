{
  "name": "Employee onboarding",
  "description": "Use it in a request to collect a new hire's payroll data — the details nobody should be sending over plain email.",
  "schema": {
    "records": [
      {
        "key": "full_name",
        "label": "Full name",
        "type": "text",
        "required": true
      },
      {
        "key": "date_of_birth",
        "label": "Date of birth",
        "type": "datetime",
        "required": true
      },
      {
        "key": "tax_id",
        "label": "Tax ID",
        "type": "text",
        "required": true,
        "reason": "Needed for payroll registration."
      },
      {
        "key": "social_insurance_number",
        "label": "Social insurance number",
        "type": "text"
      },
      {
        "key": "health_insurer",
        "label": "Health insurer",
        "type": "text"
      },
      {
        "key": "start_date",
        "label": "Start date",
        "type": "datetime"
      }
    ],
    "sections": [
      {
        "key": "bank_account",
        "name": "Bank account",
        "records": [
          {
            "key": "account_holder",
            "label": "Account holder",
            "type": "text"
          },
          {
            "key": "iban",
            "label": "IBAN",
            "type": "text",
            "required": true,
            "reason": "Salary payments go here."
          },
          {
            "key": "bic",
            "label": "BIC",
            "type": "text"
          }
        ]
      },
      {
        "key": "documents",
        "name": "Documents",
        "records": [
          {
            "key": "id_scan",
            "label": "ID document",
            "type": "file"
          },
          {
            "key": "certificates",
            "label": "Certificates / diplomas",
            "type": "file"
          }
        ]
      }
    ]
  }
}
