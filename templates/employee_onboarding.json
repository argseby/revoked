{
  "name": "Employee onboarding",
  "description": "Use it in a request to collect a new hire's payroll data — the details nobody should be sending over plain email.",
  "schema": {
    "records": [
      {
        "key": "full_name",
        "label": "Full name",
        "type": "text",
        "required": true
      },
      {
        "key": "date_of_birth",
        "label": "Date of birth",
        "type": "datetime",
        "required": true
      },
      {
        "key": "tax_id",
        "label": "Tax ID",
        "type": "text",
        "required": true,
        "reason": "Needed for payroll registration."
      },
      {
        "key": "social_insurance_number",
        "label": "Social insurance number",
        "type": "text"
      },
      {
        "key": "health_insurer",
        "label": "Health insurer",
        "type": "text"
      },
      {
        "key": "start_date",
        "label": "Start date",
        "type": "datetime"
      }
    ],
    "sections": [
      {
        "key": "bank_account",
        "name": "Bank account",
        "records": [
          {
            "key": "account_holder",
            "label": "Account holder",
            "type": "text"
          },
          {
            "key": "iban",
            "label": "IBAN",
            "type": "text",
            "required": true,
            "reason": "Salary payments go here."
          },
          {
            "key": "bic",
            "label": "BIC",
            "type": "text"
          }
        ]
      },
      {
        "key": "documents",
        "name": "Documents",
        "records": [
          {
            "key": "id_scan",
            "label": "ID document",
            "type": "file"
          },
          {
            "key": "certificates",
            "label": "Certificates / diplomas",
            "type": "file"
          }
        ]
      }
    ],
    "view": {
      "version": 1,
      "id": "onboarding",
      "name": "Onboarding",
      "accent": "green",
      "match": [
        "start_date",
        "tax_id",
        "full_name"
      ],
      "blocks": [
        {
          "type": "header",
          "icon": "person",
          "eyebrow": "Employee onboarding",
          "title": "{full_name}",
          "subtitle": "Born {date_of_birth|date}"
        },
        {
          "type": "countdown",
          "label": "First day",
          "key": "start_date",
          "warnDays": 14
        },
        {
          "type": "facts",
          "items": [
            {
              "label": "Tax ID",
              "value": "{tax_id}",
              "mono": true
            },
            {
              "label": "Social insurance number",
              "value": "{social_insurance_number}",
              "mono": true
            },
            {
              "label": "Health insurer",
              "value": "{health_insurer}"
            }
          ]
        },
        {
          "type": "divider",
          "when": {
            "key": "iban"
          }
        },
        {
          "type": "facts",
          "items": [
            {
              "label": "Account holder",
              "value": "{account_holder}"
            },
            {
              "label": "IBAN",
              "value": "{iban}",
              "mono": true
            },
            {
              "label": "BIC",
              "value": "{bic}",
              "mono": true
            }
          ]
        }
      ]
    }
  }
}
