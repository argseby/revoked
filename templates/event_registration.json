{
  "name": "Event registration",
  "description": "Use it in a request to collect participant details for a trip or event, and delete them when it is over.",
  "schema": {
    "records": [
      {
        "key": "full_name",
        "label": "Full name",
        "type": "text",
        "required": true
      },
      {
        "key": "email",
        "label": "Email address",
        "type": "text",
        "required": true
      },
      {
        "key": "phone",
        "label": "Phone number",
        "type": "text"
      },
      {
        "key": "dietary_restrictions",
        "label": "Dietary restrictions",
        "type": "text"
      },
      {
        "key": "accessibility_needs",
        "label": "Accessibility needs",
        "type": "text"
      },
      {
        "key": "arrival",
        "label": "Arrival",
        "type": "datetime"
      },
      {
        "key": "departure",
        "label": "Departure",
        "type": "datetime"
      },
      {
        "key": "photo_consent",
        "label": "Photo consent",
        "type": "boolean",
        "reason": "May photos of you from the event be published?"
      }
    ],
    "view": {
      "version": 1,
      "id": "event",
      "name": "Event registration",
      "accent": "amber",
      "match": [
        "arrival",
        "full_name"
      ],
      "blocks": [
        {
          "type": "header",
          "icon": "calendar",
          "eyebrow": "Event registration",
          "title": "{full_name}",
          "subtitle": "{arrival|date} – {departure|date}"
        },
        {
          "type": "badges",
          "items": [
            {
              "text": "Photos allowed",
              "tone": "success",
              "when": {
                "key": "photo_consent",
                "is": "true"
              }
            },
            {
              "text": "No photos",
              "tone": "warning",
              "when": {
                "key": "photo_consent",
                "is": "false"
              }
            }
          ]
        },
        {
          "type": "countdown",
          "label": "Arrival",
          "key": "arrival",
          "warnDays": 7
        },
        {
          "type": "facts",
          "items": [
            {
              "label": "Dietary restrictions",
              "value": "{dietary_restrictions}"
            },
            {
              "label": "Accessibility needs",
              "value": "{accessibility_needs}"
            }
          ]
        },
        {
          "type": "actions",
          "items": [
            {
              "label": "Call",
              "key": "phone",
              "kind": "tel"
            },
            {
              "label": "Email",
              "key": "email",
              "kind": "mail"
            }
          ]
        }
      ]
    }
  }
}
