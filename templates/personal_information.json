{
  "name": "Personal information",
  "description": "The identity details forms keep asking for — share them once, revocably, instead of retyping them into every portal.",
  "schema": {
    "records": [
      {
        "key": "full_name",
        "label": "Full name",
        "type": "text",
        "required": true,
        "reason": "Your legal name, as it appears on your ID."
      },
      {
        "key": "date_of_birth",
        "label": "Date of birth",
        "type": "datetime",
        "required": true
      },
      {
        "key": "email",
        "label": "Email address",
        "type": "text"
      },
      {
        "key": "phone",
        "label": "Phone number",
        "type": "text"
      },
      {
        "key": "nationality",
        "label": "Nationality",
        "type": "text"
      }
    ],
    "sections": [
      {
        "key": "address",
        "name": "Address",
        "records": [
          {
            "key": "street",
            "label": "Street and number",
            "type": "text"
          },
          {
            "key": "postal_code",
            "label": "Postal code",
            "type": "text"
          },
          {
            "key": "city",
            "label": "City",
            "type": "text"
          },
          {
            "key": "country",
            "label": "Country",
            "type": "text"
          }
        ]
      },
      {
        "key": "identity_documents",
        "name": "Identity documents",
        "records": [
          {
            "key": "passport_number",
            "label": "Passport number",
            "type": "text",
            "reason": "Only the number — never share a scan over an open link."
          },
          {
            "key": "passport_expiry",
            "label": "Passport expiry",
            "type": "datetime"
          },
          {
            "key": "passport_scan",
            "label": "Passport scan",
            "type": "file"
          }
        ]
      },
      {
        "key": "emergency_contact",
        "name": "Emergency contact",
        "records": [
          {
            "key": "emergency_name",
            "label": "Name",
            "type": "text"
          },
          {
            "key": "emergency_phone",
            "label": "Phone number",
            "type": "text"
          },
          {
            "key": "emergency_relation",
            "label": "Relationship",
            "type": "text"
          }
        ]
      }
    ],
    "view": {
      "version": 1,
      "id": "personal",
      "name": "ID card",
      "accent": "blue",
      "match": [
        "full_name",
        "date_of_birth"
      ],
      "blocks": [
        {
          "type": "header",
          "icon": "person",
          "eyebrow": "Personal information",
          "title": "{full_name}",
          "subtitle": "Born {date_of_birth|date}"
        },
        {
          "type": "facts",
          "items": [
            {
              "label": "Nationality",
              "value": "{nationality}"
            },
            {
              "label": "Address",
              "value": "{street}, {postal_code} {city}"
            },
            {
              "label": "Passport number",
              "value": "{passport_number}",
              "mono": true
            }
          ]
        },
        {
          "type": "countdown",
          "label": "Passport expires",
          "key": "passport_expiry",
          "warnDays": 180
        },
        {
          "type": "facts",
          "items": [
            {
              "label": "Emergency contact",
              "value": "{emergency_name}"
            },
            {
              "label": "Relation",
              "value": "{emergency_relation}"
            }
          ]
        },
        {
          "type": "actions",
          "items": [
            {
              "label": "Call",
              "key": "phone",
              "kind": "tel"
            },
            {
              "label": "Email",
              "key": "email",
              "kind": "mail"
            },
            {
              "label": "Call {emergency_name}",
              "key": "emergency_phone",
              "kind": "tel"
            }
          ]
        }
      ]
    }
  }
}
