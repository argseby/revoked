{
  "name": "Household account",
  "description": "A login the family shares — streaming, utilities, the pizza place. One source of truth instead of a group chat.",
  "schema": {
    "records": [
      {
        "key": "service_name",
        "label": "Service",
        "type": "text",
        "required": true
      },
      {
        "key": "service_url",
        "label": "Login page",
        "type": "url"
      },
      {
        "key": "login_email",
        "label": "Email / username",
        "type": "text",
        "required": true
      },
      {
        "key": "password",
        "label": "Password",
        "type": "text",
        "format": "hidden",
        "required": true
      },
      {
        "key": "backup_codes",
        "label": "2FA backup codes",
        "type": "text",
        "format": "hidden",
        "reason": "One-time codes — share them only with people you would hand your unlocked phone."
      }
    ],
    "view": {
      "version": 1,
      "id": "household",
      "name": "Account login",
      "accent": "teal",
      "match": [
        "service_name",
        "login_email"
      ],
      "blocks": [
        {
          "type": "header",
          "icon": "key",
          "eyebrow": "Household account",
          "title": "{service_name}"
        },
        {
          "type": "facts",
          "items": [
            {
              "label": "Login",
              "value": "{login_email}",
              "mono": true
            }
          ]
        },
        {
          "type": "secret",
          "label": "Password",
          "key": "password"
        },
        {
          "type": "secret",
          "label": "Backup codes",
          "key": "backup_codes"
        },
        {
          "type": "actions",
          "items": [
            {
              "label": "Open {service_name}",
              "key": "service_url",
              "kind": "url"
            }
          ]
        }
      ]
    }
  }
}
