{
  "name": "API credentials",
  "description": "A service account for one integration. Rotate the secret here — every active share resolves the new value at read time.",
  "schema": {
    "records": [
      {
        "key": "base_url",
        "label": "Base URL",
        "type": "url",
        "required": true
      },
      {
        "key": "client_id",
        "label": "Client / key ID",
        "type": "text"
      },
      {
        "key": "client_secret",
        "label": "Secret",
        "type": "text",
        "format": "hidden",
        "required": true,
        "reason": "Never paste this into a chat — share a revocable link instead."
      },
      {
        "key": "expires_at",
        "label": "Expires",
        "type": "datetime"
      },
      {
        "key": "docs_url",
        "label": "API documentation",
        "type": "url"
      }
    ],
    "view": {
      "version": 1,
      "id": "api_credentials",
      "name": "API credentials",
      "accent": "violet",
      "match": [
        "client_id"
      ],
      "blocks": [
        {
          "type": "header",
          "icon": "key",
          "eyebrow": "API credentials",
          "title": "{base_url}"
        },
        {
          "type": "facts",
          "items": [
            {
              "label": "Client ID",
              "value": "{client_id}",
              "mono": true
            }
          ]
        },
        {
          "type": "secret",
          "label": "Client secret",
          "key": "client_secret"
        },
        {
          "type": "countdown",
          "label": "Credentials expire",
          "key": "expires_at",
          "warnDays": 30
        },
        {
          "type": "actions",
          "items": [
            {
              "label": "API documentation",
              "key": "docs_url",
              "kind": "url"
            }
          ]
        }
      ]
    }
  }
}
