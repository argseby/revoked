# Where this demo is reached. Its origin is the OpenID Connect client id, and
# /callback on it is the redirect address.
PUBLIC_URL=http://localhost:4000
PORT=4000

# When set, only these servers may be used (comma-separated domains).
# REVOKED_SERVERS=revoked.example,localhost:8090

# Vault keys asked for at sign-in, answered with live grants.
REQUESTED_KEYS=shipping_address,phone
