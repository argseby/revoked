# REVOKED_SERVER is the revoked API the page offers by default; see
# 15-revoked-config.envsh for REVOKED_CUSTOM_SERVERS.
server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    root /usr/share/nginx/html;

    # add_header in a location replaces the server's set, so every location
    # includes the same file.
    include /etc/nginx/conf.d/security_headers.inc;

    location = /config.json {
        include /etc/nginx/conf.d/security_headers.inc;
        add_header Cache-Control "no-store" always;
        default_type application/json;
        return 200 '{"server":"${REVOKED_SERVER}","customServers":${REVOKED_CUSTOM_SERVERS}}';
    }

    location /assets/ {
        include /etc/nginx/conf.d/security_headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;

        # The pdf.js worker is an ES module; nginx's mime.types has no .mjs,
        # and a browser refuses to run a module served as octet-stream.
        location ~ \.mjs$ {
            include /etc/nginx/conf.d/security_headers.inc;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            types { }
            default_type text/javascript;
            try_files $uri =404;
        }
    }

    location / {
        include /etc/nginx/conf.d/security_headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
