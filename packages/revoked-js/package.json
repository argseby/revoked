{
  "name": "@kiunke.dev/revoked",
  "version": "0.1.0",
  "description": "TypeScript client for the Revoked API: shares, requests, vault, webhooks, identities and connected tools.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argseby/revoked.git",
    "directory": "packages/revoked-js"
  },
  "homepage": "https://github.com/argseby/revoked/tree/main/packages/revoked-js",
  "keywords": [
    "revoked",
    "secret-sharing",
    "sdk",
    "api-client"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./public": {
      "import": "./dist/public.js",
      "require": "./dist/public.cjs"
    },
    "./connect": {
      "import": "./dist/connect.js",
      "require": "./dist/connect.cjs"
    },
    "./webhooks": {
      "import": "./dist/webhooks.js",
      "require": "./dist/webhooks.cjs"
    },
    "./identity": {
      "import": "./dist/identity.js",
      "require": "./dist/identity.cjs"
    },
    "./trust": {
      "import": "./dist/trust.js",
      "require": "./dist/trust.cjs"
    },
    "./sealed": {
      "import": "./dist/sealed.js",
      "require": "./dist/sealed.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint:package": "publint --strict && attw --pack . --profile node16",
    "prepublishOnly": "npm run check && npm test && npm run build && npm run lint:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "22.20.5",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
